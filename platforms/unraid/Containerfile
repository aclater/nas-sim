# SPDX-License-Identifier: MIT
# nas-sim/unraid: a simulated Unraid layout, from unmodified UBI 9 packages. Build from the
# repository root.
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:f8700bef6b1c99d806c13e43542ce9f2534b137914ade791e4ced7283221147b
USER 0
RUN microdnf -y install tar gzip util-linux findutils procps-ng kmod wget && microdnf clean all
COPY platforms/unraid/root/ /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LABEL org.opencontainers.image.title="nas-sim/unraid" \
      org.opencontainers.image.description="Simulated Unraid layout for install tests: identity files, userland, storage paths. Not the vendor's system." \
      org.opencontainers.image.source="https://github.com/aclater/nas-sim" \
      org.opencontainers.image.licenses="MIT AND GPL-2.0-only AND LGPL-2.1-or-later" \
      io.github.aclater.nas-sim.platform="unraid" \
      io.github.aclater.nas-sim.shell="bash" \
      io.github.aclater.nas-sim.systemd="absent" \
      io.github.aclater.nas-sim.container-engine="Docker (not running in the container)"
CMD ["/bin/sh"]
