#!/bin/sh
# SPDX-License-Identifier: MIT
# nas-sim stand-in: read KEY from [SECTION] of an ini-style file (written for nas-sim).
#   getcfg SECTION KEY [-f FILE] [-d DEFAULT]
section=$1 key=$2
shift 2
file=/etc/config/uLinux.conf default=''
while [ "$#" -gt 0 ]; do
    case $1 in -f) file=$2; shift ;; -d) default=$2; shift ;; esac
    shift
done
v=$(awk -v s="[$section]" -v k="$key" '
    /^\[/ { in_s = ($0 == s); next }
    in_s { split($0, a, " = "); if (a[1] == k) { print substr($0, length(k) + 4); exit } }' "$file" 2>/dev/null)
if [ -n "$v" ]; then echo "$v"; elif [ -n "$default" ]; then echo "$default"; fi
